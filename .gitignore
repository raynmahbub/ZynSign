# macOS
.DS_Store

# Xcode user state — never commit; may contain personal paths
xcuserdata/
*.xcuserstate

# Xcode build products and test results
DerivedData/
*.xcresult

# Python bytecode from host scripts
__pycache__/
*.pyc

# External validation output from local runs (regenerated on every run)
.external-validation/

# Hardening report output from Scripts/generate_hardening_report.py
# (regenerated on every run; CI uploads it as an artifact)
build/

# Composed store screenshots are generated from Assets/Screenshots/raw
Assets/Screenshots/store/

# CI-generated reports — produced by Scripts/ci/*, uploaded as
# artifacts; only the README is versioned
Reports/*
!Reports/README.md

# Engineering tooling (commitlint / commitizen)
node_modules/
